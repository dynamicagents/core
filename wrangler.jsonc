{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Dev-only. `@dynamicagents/core` is a library and never deploys — this config
  // exists so `@cloudflare/vitest-plugin` has a Worker to bind, and so
  // `wrangler types` can generate the ambient `Cloudflare.Env` that
  // `test/worker.ts` types itself against. It is excluded from the published
  // tarball by `package.json`'s `files` allowlist; a consumer brings their own.
  "name": "da-core-test",
  "main": "test/worker.ts",
  "compatibility_date": "2026-07-01",

  // The Agents SDK reaches for Node builtins (`node:async_hooks` among others),
  // and `AgentDB` runs Drizzle's durable-sqlite migrator. Both need this.
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [
      { "name": "TEST_AGENT", "class_name": "TestAgent" },
      { "name": "TEST_SUBAGENT", "class_name": "TestSubagent" },
      { "name": "PLAIN_SCHEDULED", "class_name": "PlainScheduled" },
      { "name": "DELEGATING_SCHEDULED", "class_name": "DelegatingScheduled" }
    ]
  },

  // `new_sqlite_classes`, not `new_classes`: `AgentDB` talks to `ctx.storage.sql`
  // (see `src/db/db.ts`), which only exists on a SQLite-backed Durable Object.
  // A key-value DO fails at the first migration.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TestAgent", "TestSubagent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PlainScheduled", "DelegatingScheduled"]
    }
  ]
}
