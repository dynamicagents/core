{
  // The test-side project. Separate from the root config because tests may see
  // things `src/` deliberately cannot — chiefly the `cloudflare:test` module.
  // `npm run check` typechecks both projects, so a spec that drifts from the
  // source fails the build.
  //
  // The `types` array is restated rather than inherited, because a relative entry
  // resolves against the config that declares it: `./worker-configuration.d.ts`
  // in the root config would look for `test/worker-configuration.d.ts` here. The
  // list is otherwise the root's — see the note there for why the runtime types
  // are a committed file and why they are generated with `--include-env=false`.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [
      "../worker-configuration.d.ts",
      "@cloudflare/vitest-plugin/types",
      "node"
    ]
  },
  // Only the test host and the build config. Specs co-located under `src/` are
  // covered by the root project — see the note there about eslint's resolution.
  "include": [
    "./**/*.ts",
    "../vitest.config.ts",
    "../worker-configuration.d.ts"
  ]
}
